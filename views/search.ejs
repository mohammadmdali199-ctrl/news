<%- include('partials/header') %>

<div class="container my-4">
    <div class="row">
        <div class="col-12">
            <h1>Search Results</h1>
            <% if (query) { %>
                <p class="lead">Showing results for "<%= query %>"</p>
            <% } %>

            <div class="search-form mb-4">
                <form action="/search" method="GET" class="d-flex">
                    <input type="text" name="q" class="form-control me-2" placeholder="Search news..." value="<%= query %>">
                    <button type="submit" class="btn btn-primary">Search</button>
                </form>
            </div>
        </div>
    </div>

    <div class="row">
        <% if (news && news.length > 0) { %>
            <% news.forEach(item => { %>
                <div class="col-md-4 mb-4">
                    <div class="card news-card">
                        <img src="<%= item.image || '/images/placeholder.jpg' %>" class="card-img-top" alt="<%= item.title %>">
                        <div class="card-body">
                            <h5 class="card-title"><a href="/news/<%= item.slug %>"><%= item.title %></a></h5>
                            <p class="card-text"><%= item.summary ? item.summary.substring(0, 100) + '...' : '' %></p>
                            <div class="news-meta">
                                <small class="text-muted">
                                    <i class="fas fa-user"></i> <%= item.author_name %> |
                                    <i class="fas fa-clock"></i> <%= new Date(item.created_at).toLocaleDateString() %>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else if (query) { %>
            <div class="col-12">
                <div class="alert alert-info">
                    <h4>No results found</h4>
                    <p>No news articles match your search query. Try different keywords.</p>
                </div>
            </div>
        <% } else { %>
            <div class="col-12">
                <div class="alert alert-secondary">
                    <h4>Enter a search query</h4>
                    <p>Use the search box above to find news articles.</p>
                </div>
            </div>
        <% } %>
    </div>

    <% if (pagination && pagination.totalPages > 1) { %>
        <div class="row">
            <div class="col-12">
                <nav aria-label="Search results pagination">
                    <ul class="pagination justify-content-center">
                        <% if (pagination.currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="?q=<%= query %>&page=<%= pagination.currentPage - 1 %>">Previous</a>
                            </li>
                        <% } %>

                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                            <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                                <a class="page-link" href="?q=<%= query %>&page=<%= i %>"><%= i %></a>
                            </li>
                        <% } %>

                        <% if (pagination.currentPage < pagination.totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" href="?q=<%= query %>&page=<%= pagination.currentPage + 1 %>">Next</a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>