<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'News Portal' %></title>
    <meta name="description" content="<%= description || 'Professional News Portal' %>">
    <meta name="keywords" content="news, bangladesh, politics, economy, international, technology, sports">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Breaking News Ticker -->
    <div class="breaking-news bg-danger text-white py-2">
        <div class="container">
            <div class="row">
                <div class="col-md-2">
                    <strong>Breaking News:</strong>
                </div>
                <div class="col-md-10">
                    <div class="ticker">
                        <div class="ticker-content">
                            <% if (breakingNews && breakingNews.length > 0) { %>
                                <% breakingNews.forEach(news => { %>
                                    <span><a href="<%= news.link || '#' %>" class="text-white"><%= news.title %></a></span>
                                <% }); %>
                            <% } else { %>
                                <span>No breaking news at the moment</span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Header -->
    <header class="main-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <div class="logo">
                        <a href="/">
                            <img src="/images/logo.png" alt="News Portal" class="img-fluid" style="max-height: 60px;">
                        </a>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <div class="date-time">
                        <span id="current-date"></span>
                        <span id="current-time"></span>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <div class="social-media">
                        <a href="#" class="text-dark me-2"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-dark me-2"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-dark me-2"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="text-dark me-2"><i class="fab fa-instagram"></i></a>
                    </div>
                    <div class="search-box mt-2">
                        <form action="/search" method="GET" class="d-flex">
                            <input type="text" name="q" class="form-control form-control-sm" placeholder="Search...">
                            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/category/bangladesh">Bangladesh</a></li>
                    <li class="nav-item"><a class="nav-link" href="/category/politics">Politics</a></li>
                    <li class="nav-item"><a class="nav-link" href="/category/economy">Economy</a></li>
                    <li class="nav-item"><a class="nav-link" href="/category/international">International</a></li>
                    <li class="nav-item"><a class="nav-link" href="/category/technology">Technology</a></li>
                    <li class="nav-item"><a class="nav-link" href="/category/sports">Sports</a></li>
                    <li class="nav-item"><a class="nav-link" href="/category/opinion">Opinion</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-globe"></i> EN
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="?lang=en">English</a></li>
                            <li><a class="dropdown-item" href="?lang=bn">বাংলা</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-3">
                    <h5>About Us</h5>
                    <p>Professional news portal providing latest news and updates from Bangladesh and around the world.</p>
                </div>
                <div class="col-md-3">
                    <h5>Categories</h5>
                    <ul class="list-unstyled">
                        <li><a href="/category/bangladesh" class="text-white">Bangladesh</a></li>
                        <li><a href="/category/politics" class="text-white">Politics</a></li>
                        <li><a href="/category/economy" class="text-white">Economy</a></li>
                        <li><a href="/category/international" class="text-white">International</a></li>
                        <li><a href="/category/technology" class="text-white">Technology</a></li>
                        <li><a href="/category/sports" class="text-white">Sports</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Follow Us</h5>
                    <div class="social-links">
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-instagram"></i></a>
                    </div>
                    <h5 class="mt-3">Newsletter</h5>
                    <form action="/newsletter" method="POST">
                        <div class="input-group">
                            <input type="email" name="email" class="form-control" placeholder="Enter email">
                            <button class="btn btn-primary" type="submit">Subscribe</button>
                        </div>
                    </form>
                </div>
                <div class="col-md-3">
                    <h5>Contact</h5>
                    <p><i class="fas fa-map-marker-alt"></i> Dhaka, Bangladesh</p>
                    <p><i class="fas fa-phone"></i> +880 123 456 789</p>
                    <p><i class="fas fa-envelope"></i> info@newsportal.com</p>
                    <div class="mt-3">
                        <a href="/contact" class="btn btn-outline-light btn-sm">Contact Us</a>
                        <a href="/privacy" class="btn btn-outline-light btn-sm ms-2">Privacy Policy</a>
                    </div>
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-md-6">
                    <p>&copy; 2024 News Portal. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-end">
                    <p>Powered by <a href="#" class="text-white">News Portal Team</a></p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <!-- Custom JS -->
    <script src="/js/main.js"></script>
</body>
</html>